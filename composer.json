{
    "name": "umiushi-lab/carbon",
    "type": "library",
    "description": "Carbon 1.36.2 with security fixes backported, for EC-CUBE 3.0.x shops that cannot move off the versions EC-CUBE 3.0.18 ships",
    "keywords": [
        "date",
        "time",
        "DateTime"
    ],
    "homepage": "http://carbon.nesbot.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Nesbitt",
            "email": "brian@nesbot.com",
            "homepage": "http://nesbot.com"
        }
    ],
    "require": {
        "php": ">=5.3.9",
        "symfony/translation": "~2.6 || ~3.0 || ~4.0"
    },
    "autoload": {
        "psr-4": {
            "": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "replace": {
        "nesbot/carbon": "1.36.2"
    },
    "support": {
        "issues": "https://github.com/umiushi-lab/carbon/issues"
    }
}
